[gd_resource type="Theme" format=3]

[sub_resource type="SystemFont" id="Body"]
font_names = PackedStringArray("Segoe UI", "Noto Sans", "DejaVu Sans")

[sub_resource type="SystemFont" id="Display"]
font_names = PackedStringArray("Georgia", "Noto Serif", "DejaVu Serif")
font_weight = 700

[sub_resource type="StyleBoxFlat" id="Primary"]
content_margin_left = 20.0
content_margin_right = 20.0
bg_color = Color(0.88, 0.73, 0.54, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_left = 4
corner_radius_bottom_right = 4

