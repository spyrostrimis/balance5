border_color = Color(0.60, 0.42, 0.26, 0.95)
corner_radius_top_right = 4
corner_radius_bottom_right = 4

[resource]
default_font = SubResource("Body")
default_font_size = 18
Label/colors/font_color = Color(0.97, 0.90, 0.80, 1)
DisplayLabel/base_type = &"Label"
DisplayLabel/fonts/font = SubResource("Display")
