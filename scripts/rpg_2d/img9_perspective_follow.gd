class_name Img9PerspectiveFollow
extends Control
## Standalone 2.5D Perspective Follow-Camera Proof-of-Concept adapted onto Image 9.
## Strict scope: exploration walk only (no combat, no shooting, no enemies, no Tiled grid).
## All canyon layers (repaired cobbles, sand verge, curbs, 6 contoured wall wings, boulders,
## sagebushes, horizon backdrop) are sliced directly from img9_reference.jpg (192-color palette).

const ART_BASE := Vector2i(960, 540)
const BOOTS := Vector2(486.0, 320.0)
const HORIZON := 88.0
const DEPTH := 260.0

const ROAD_START := -140.0
const ROAD_END := 520.0
const WALK_SPEED_LATERAL := 115.0
const WALK_SPEED_UPHILL := 130.0
const BOOT_EDGE_MARGIN := 10.0

# Calibrated S-curve marks: Vector3(distance_uphill, road_center_x, road_half_width)
# Matches tools/python/build_img9_perspective_art.py ROUTE_MARKS exactly.
const MARKS := [
	Vector3(-260.0, 38.0, 62.0),
	Vector3(-120.0, 34.0, 62.0),
	Vector3(-75.0, 82.0, 63.0),
	Vector3(-35.0, 64.0, 68.0),
	Vector3(0.0, 0.0, 74.0),
	Vector3(55.0, -56.0, 82.0),
	Vector3(138.0, -64.0, 94.0),
	Vector3(275.0, 60.0, 108.0),
	Vector3(455.0, 152.0, 118.0),
	Vector3(760.0, 48.0, 130.0),
	Vector3(1350.0, 18.0, 145.0),
	Vector3(2600.0, 115.0, 155.0),
]

const TEX_ATLAS := preload("res://assets/textures/rpg_2d/img9_perspective/props_atlas.png")
const TEX_HORIZON := preload("res://assets/textures/rpg_2d/img9_perspective/horizon_backdrop.png")
const TEX_COBBLE := preload("res://assets/textures/rpg_2d/img9_perspective/cobble_tile.png")
const TEX_SAND := preload("res://assets/textures/rpg_2d/img9_perspective/sand_verge_tile.png")
const TEX_CURB := preload("res://assets/textures/rpg_2d/img9_perspective/curb_strip.png")
const TEX_REF := preload("res://assets/textures/rpg_2d/img9_perspective/img9_ref_960x540.png")
const TEX_HERO := preload("res://assets/textures/rpg_2d/sprites/blue_commander_sheet.png")
const TEX_SHADOW := preload("res://assets/textures/rpg_2d/sprites/contact_shadow.png")
const SHADER_GROUND := preload("res://assets/shaders/rpg_2d/img9_ground.gdshader")

# Atlas entries generated by tools/python/build_img9_perspective_art.py:
# key -> [Rect2(x, y, w, h), pivot Vector2, anchor_img9 Vector2]
const ATLAS_DEF := {
	"left_mid_drystone_wall": [Rect2(4, 4, 497, 375), Vector2(358, 362), Vector2(248, 362)],
	"right_mid_drystone_wall": [Rect2(507, 4, 431, 371), Vector2(60, 292), Vector2(700, 318)],
	"left_fg_terraced_ledge": [Rect2(944, 4, 441, 303), Vector2(261, 219), Vector2(165, 495)],
	"right_fg_shaded_step": [Rect2(1391, 4, 299, 289), Vector2(54, 202), Vector2(812, 492)],
	"left_upper_terracotta_cliff": [Rect2(1696, 4, 201, 159), Vector2(124, 146), Vector2(420, 146)],
	"right_upper_sunlit_cliff": [Rect2(4, 385, 543, 157), Vector2(114, 144), Vector2(642, 144)],
	"bush_left_fg": [Rect2(553, 385, 107, 88), Vector2(52, 76), Vector2(304, 420)],
	"boulder_left_sunlit": [Rect2(666, 385, 107, 81), Vector2(52, 70), Vector2(288, 356)],
	"bush_right_mid": [Rect2(779, 385, 85, 75), Vector2(42, 64), Vector2(642, 314)],
	"boulder_bend_left": [Rect2(870, 385, 95, 73), Vector2(44, 66), Vector2(392, 194)],
	"curb_right_a": [Rect2(971, 385, 45, 47), Vector2(22, 34), Vector2(670, 432)],
	"curb_left_b": [Rect2(1022, 385, 51, 43), Vector2(28, 32), Vector2(456, 488)],
	"curb_left_a": [Rect2(1079, 385, 43, 35), Vector2(22, 26), Vector2(490, 434)],
	"curb_mid_a": [Rect2(1128, 385, 45, 33), Vector2(24, 22), Vector2(404, 326)],
}

const HERO_BASE_SCALE := 1.40
const HERO_PIVOT := Vector2(32.0, 92.0)

class PropItem:
	var sprite: Sprite2D
	var ground: Vector2        # (lateral_offset, distance_uphill)
	var pivot: Vector2         # local pixel pivot in texture
	var art_scale: float       # multiplier so view_scale * art_scale = exact art size
	var flip_h: bool
	var is_wall: bool          # walls keep larger near-camera cull margin & subtle horizon haze
	var z_bias: int            # deterministic ordering for nested walls
	var base_tint: Color

@export var leeway_enabled := false
@export_range(0.0, 16.0, 1.0) var leeway_pixels := 8.0

# Hero state in ground units: (lateral offset from road center, distance uphill)
# Spawns at (24, 0) so boots project to (510, 320), matching Image 9's standing stance.
var hero_ground := Vector2(24.0, 0.0)
var camera_distance := 0.0
var camera_center := 0.0
var current_res := Vector2i(960, 540)
var showing_reference := false
var hud_visible := true

var _facing_dir := Vector2.DOWN
var _anim_phase := 0.0
var _props: Array[PropItem] = []
var _ground_mat: ShaderMaterial = null
var _window: Window = null
var _prev_scale_mode: Window.ContentScaleMode

@onready var world_viewport: SubViewport = $WorldViewport
@onready var scene_root: Node2D = $WorldViewport/SceneRoot
@onready var horizon_sprite: Sprite2D = $WorldViewport/SceneRoot/HorizonBackdrop
@onready var ground_rect: ColorRect = $WorldViewport/SceneRoot/GroundSurface
@onready var depth_layer: Node2D = $WorldViewport/SceneRoot/DepthLayer
@onready var commander_node: Node2D = $WorldViewport/SceneRoot/DepthLayer/Commander
@onready var commander_shadow: Sprite2D = $WorldViewport/SceneRoot/DepthLayer/Commander/ContactShadow
@onready var commander_sprite: Sprite2D = $WorldViewport/SceneRoot/DepthLayer/Commander/BodySprite
@onready var reference_overlay: Sprite2D = $WorldViewport/SceneRoot/ReferenceOverlay
@onready var viewport_display: TextureRect = $ViewportDisplay
@onready var hud_layer: CanvasLayer = $HUD
@onready var status_label: Label = $HUD/Panel/Margin/VBox/StatusLabel
@onready var controls_label: Label = $HUD/Panel/Margin/VBox/ControlsLabel


static func road_at(distance: float) -> Vector2:
	for i in range(1, MARKS.size()):
		var after: Vector3 = MARKS[i]
		if distance <= after.x:
			var before: Vector3 = MARKS[i - 1]
			var w := smoothstep(before.x, after.x, distance)
			return Vector2(before.y, before.z).lerp(Vector2(after.y, after.z), w)
	var last: Vector3 = MARKS[-1]
	return Vector2(last.y, last.z)


static func scale_at(distance: float, cam_dist: float) -> float:
	return DEPTH / maxf(DEPTH + distance - cam_dist, 1.0)


static func distance_at(art_y: float) -> float:
	return DEPTH * ((BOOTS.y - HORIZON) / maxf(art_y - HORIZON, 1.0) - 1.0)


static func project_point(ground_pt: Vector2, cam_dist: float, cam_center: float) -> Vector2:
	var vs := scale_at(ground_pt.y, cam_dist)
	return Vector2(
		BOOTS.x + (ground_pt.x + road_at(ground_pt.y).x - cam_center) * vs,
		HORIZON + (BOOTS.y - HORIZON) * vs
	)


static func _make_atlas_region(area: Rect2) -> AtlasTexture:
	var tex := AtlasTexture.new()
	tex.atlas = TEX_ATLAS
	tex.region = area
	tex.filter_clip = true
	return tex


func _ready() -> void:
	_window = get_window()
	if _window != null:
		_prev_scale_mode = _window.content_scale_mode
		_window.content_scale_mode = Window.CONTENT_SCALE_MODE_DISABLED

	# Pixel-snapped SubViewport wired to crisp nearest TextureRect
	world_viewport.canvas_item_default_texture_filter = Viewport.DEFAULT_CANVAS_ITEM_TEXTURE_FILTER_NEAREST
	world_viewport.snap_2d_transforms_to_pixel = true
	world_viewport.snap_2d_vertices_to_pixel = true
	viewport_display.texture = world_viewport.get_texture()
	viewport_display.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	resized.connect(_fit_display)

	# Horizon backdrop pinned near Y = 88 (centered horizontally with 96px parallax wings)
	horizon_sprite.texture = TEX_HORIZON
	horizon_sprite.centered = false
	horizon_sprite.position = Vector2(-96.0, 0.0)

	# Reference overlay (untouched 960x540 Image 9, toggled via F2)
	reference_overlay.texture = TEX_REF
	reference_overlay.centered = false
	reference_overlay.visible = false

	# Perspective ground shader (pure Image-9 cobble, sand, and curb textures)
	_ground_mat = ShaderMaterial.new()
	_ground_mat.shader = SHADER_GROUND
	_ground_mat.set_shader_parameter("cobble_tex", TEX_COBBLE)
	_ground_mat.set_shader_parameter("sand_tex", TEX_SAND)
	_ground_mat.set_shader_parameter("curb_tex", TEX_CURB)
	_ground_mat.set_shader_parameter("road_marks", PackedVector3Array(MARKS))
	_ground_mat.set_shader_parameter("depth", DEPTH)
	_ground_mat.set_shader_parameter("boots", BOOTS)
	_ground_mat.set_shader_parameter("horizon", HORIZON)
	_ground_mat.set_shader_parameter("render_size", Vector2(current_res))
	ground_rect.material = _ground_mat

	# Commander sprite + grounded soft contact shadow
	commander_sprite.texture = TEX_HERO
	commander_sprite.hframes = 4
	commander_sprite.vframes = 4
	commander_sprite.centered = false
	commander_sprite.frame = 0
	commander_shadow.texture = TEX_SHADOW
	commander_shadow.centered = true
	commander_shadow.modulate = Color(0.18, 0.12, 0.14, 0.68)

	_build_canyon_props()

	if "--clean" in OS.get_cmdline_user_args():
		set_hud_visible(false)

	set_resolution_preset(960, 540)
	_fit_display()
	_update_view(true)


func _exit_tree() -> void:
	if is_instance_valid(_window):
		_window.content_scale_mode = _prev_scale_mode


func _fit_display() -> void:
	if viewport_display == null:
		return
	var fit := minf(size.x / float(ART_BASE.x), size.y / float(ART_BASE.y))
	viewport_display.size = (Vector2(ART_BASE) * fit).floor()
	viewport_display.position = ((size - viewport_display.size) * 0.5).floor()


func _add_img9_anchored_prop(
	key: String,
	depth_y: float,
	is_wall: bool,
	z_bias: int = 0,
	extra_scale: float = 1.0,
	flip_h: bool = false,
	tint: Color = Color.WHITE
) -> void:
	## Place an Image-9 cutout by mathematically inverting its exact spawn screen anchor
	## so at camera_distance = 0 it sits 1:1 on its original Image-9 coordinates and scale!
	var def: Array = ATLAS_DEF[key]
	var rect: Rect2 = def[0]
	var raw_pivot: Vector2 = def[1]
	var anchor_img9: Vector2 = def[2]

	var s0 := maxf((depth_y - HORIZON) / (BOOTS.y - HORIZON), 0.05)
	var dist := DEPTH * (1.0 / s0 - 1.0)
	var lat := (anchor_img9.x - BOOTS.x) / s0 - road_at(dist).x
	var adjusted_pivot := Vector2(raw_pivot.x, raw_pivot.y + (depth_y - anchor_img9.y))
	var art_scale := (1.0 / s0) * extra_scale

	_spawn_prop(key, rect, adjusted_pivot, Vector2(lat, dist), art_scale, flip_h, is_wall, z_bias, tint)


func _add_route_prop(
	key: String,
	lateral: float,
	distance: float,
	art_scale: float,
	is_wall: bool,
	z_bias: int = 0,
	flip_h: bool = false,
	tint: Color = Color.WHITE
) -> void:
	var def: Array = ATLAS_DEF[key]
	var rect: Rect2 = def[0]
	var raw_pivot: Vector2 = def[1]
	_spawn_prop(key, rect, raw_pivot, Vector2(lateral, distance), art_scale, flip_h, is_wall, z_bias, tint)


func _spawn_prop(
	prop_name: String,
	rect: Rect2,
	pivot: Vector2,
	ground: Vector2,
	art_scale: float,
	flip_h: bool,
	is_wall: bool,
	z_bias: int,
	tint: Color
) -> void:
	var sp := Sprite2D.new()
	sp.name = prop_name
	sp.centered = false
	sp.flip_h = flip_h
	sp.texture = _make_atlas_region(rect)
	depth_layer.add_child(sp)

	var item := PropItem.new()
	item.sprite = sp
	item.ground = ground
	item.pivot = pivot
	item.art_scale = art_scale
	item.flip_h = flip_h
	item.is_wall = is_wall
	item.z_bias = z_bias
	item.base_tint = tint
	_props.append(item)


func _build_canyon_props() -> void:
	# =========================================================================
	# A. PRIMARY IMAGE-9 COMPOSITION LAYERS (exact 1:1 spawn match to Image 9!)
	# =========================================================================
	# 1-2. Foreground terraced ledge (left) & foreground shaded step (right)
	_add_img9_anchored_prop("left_fg_terraced_ledge", 495.0, true, 6)
	_add_img9_anchored_prop("right_fg_shaded_step", 492.0, true, 6)

	# 3-4. Mid-canyon curved stepped dry-stone walls (left & right)
	# Effective depth planes sit in the mid-canyon (d ~ +75..+95) so they flow smoothly
	# past the hero as she walks uphill to d = 220 while still landing 1:1 at spawn!
	_add_img9_anchored_prop("left_mid_drystone_wall", 268.0, true, 3)
	_add_img9_anchored_prop("right_mid_drystone_wall", 262.0, true, 3)

	# 5-6. Upper terracotta cliff (left) & upper sunlit cliff with god-rays (right)
	# Depth planes sit near the upper canyon bend (d ~ +410..+440) so they grow naturally
	# to flank the hero at d = 420 while landing 1:1 at spawn!
	_add_img9_anchored_prop("left_upper_terracotta_cliff", 176.0, true, 1)
	_add_img9_anchored_prop("right_upper_sunlit_cliff", 174.0, true, 1)

	# Exact Image-9 boulders & sagebushes
	_add_img9_anchored_prop("boulder_left_sunlit", 356.0, false, 4)
	_add_img9_anchored_prop("boulder_bend_left", 194.0, false, 2)
	_add_img9_anchored_prop("bush_left_fg", 420.0, false, 5)
	_add_img9_anchored_prop("bush_right_mid", 314.0, false, 4)

	# Exact Image-9 dressed curb-stone cutouts anchoring the foreground S-curve accents
	_add_img9_anchored_prop("curb_left_b", 488.0, false, 0)
	_add_img9_anchored_prop("curb_left_a", 434.0, false, 0)
	_add_img9_anchored_prop("curb_right_a", 432.0, false, 0)
	_add_img9_anchored_prop("curb_mid_a", 326.0, false, 0)

	# =========================================================================
	# B. UPHILL CONTINUATION PROPS (matching Image 9's mid/upper canyon rhythm)
	# Tucked cleanly behind foreground/mid walls at spawn (keeping the upper-right
	# god-rays and upper-left skyline unobstructed at d = 0), then emerging smoothly
	# as the hero walks uphill around the first curve (d = 220) and toward the gap (d = 420).
	# =========================================================================
	# Mid-bend flanking continuation walls (emerge behind mid walls past d = 140)
	_add_route_prop("left_mid_drystone_wall", -395.0, 325.0, 1.25, true, 1)
	_add_route_prop("right_mid_drystone_wall", 425.0, 345.0, 1.20, true, 1)

	# Upper-canyon continuation cliffs approaching the sunlit mouth (revealed at d=350..520)
	_add_route_prop("left_upper_terracotta_cliff", -300.0, 710.0, 3.05, true, 0)
	_add_route_prop("right_upper_sunlit_cliff", 355.0, 740.0, 3.10, true, 0)
	_add_route_prop("left_upper_terracotta_cliff", -270.0, 1080.0, 3.35, true, -1)
	_add_route_prop("right_upper_sunlit_cliff", 310.0, 1120.0, 3.45, true, -1)

	# Matching Image-9 mid/upper sagebushes & boulders along the S-curve shoulders
	_add_route_prop("bush_left_fg", -148.0, 132.0, 0.72, false, 2, true)
	_add_route_prop("bush_right_mid", 162.0, 195.0, 0.90, false, 2, false)
	_add_route_prop("boulder_left_sunlit", 188.0, 255.0, 0.85, false, 2, true, Color(0.84, 0.78, 0.82))
	_add_route_prop("bush_left_fg", -165.0, 365.0, 0.82, false, 1, false)
	_add_route_prop("bush_right_mid", 172.0, 415.0, 0.95, false, 1, true)
	_add_route_prop("boulder_bend_left", -175.0, 495.0, 1.15, false, 1, false)
	_add_route_prop("boulder_left_sunlit", 195.0, 565.0, 0.96, false, 0, true, Color(0.86, 0.80, 0.84))
	_add_route_prop("bush_right_mid", -155.0, 640.0, 0.90, false, 0, false)


func _physics_process(delta: float) -> void:
	if showing_reference:
		return

	var input_dir := _read_walk_input()
	if input_dir.length_squared() > 0.001:
		var step := Vector2(
			input_dir.x * WALK_SPEED_LATERAL * delta,
			input_dir.y * WALK_SPEED_UPHILL * delta
		)
		var next_dist := clampf(hero_ground.y + step.y, ROAD_START, ROAD_END)
		var max_lat := maxf(road_at(next_dist).y - BOOT_EDGE_MARGIN, 8.0)
		var next_lat := clampf(hero_ground.x + step.x, -max_lat, max_lat)
		var moved := Vector2(next_lat - hero_ground.x, next_dist - hero_ground.y)
		hero_ground = Vector2(next_lat, next_dist)

		if moved.length_squared() > 0.0001:
			_anim_phase += delta * 7.5
			if absf(input_dir.y) >= absf(input_dir.x):
				_facing_dir = Vector2.UP if input_dir.y > 0.0 else Vector2.DOWN
			else:
				_facing_dir = Vector2.RIGHT if input_dir.x > 0.0 else Vector2.LEFT
	else:
		_anim_phase = 0.0

	_update_view(false)


func _read_walk_input() -> Vector2:
	var left := Input.is_action_pressed("ui_left") or Input.is_physical_key_pressed(KEY_A)
	var right := Input.is_action_pressed("ui_right") or Input.is_physical_key_pressed(KEY_D)
	var up := Input.is_action_pressed("ui_up") or Input.is_physical_key_pressed(KEY_W)
	var down := Input.is_action_pressed("ui_down") or Input.is_physical_key_pressed(KEY_S)
	var v := Vector2(float(int(right) - int(left)), float(int(up) - int(down)))
	return v.normalized() if v.length_squared() > 1.0 else v


func _unhandled_key_input(event: InputEvent) -> void:
	var k := event as InputEventKey
	if k == null or not k.pressed or k.echo:
		return
	# Never consume Esc (ui_cancel) so BuildLauncher returns cleanly to the Developers Page.
	if k.is_action("ui_cancel"):
		return

	match k.keycode:
		KEY_1:
			set_resolution_preset(960, 540)
			get_viewport().set_input_as_handled()
		KEY_2:
			set_resolution_preset(640, 360)
			get_viewport().set_input_as_handled()
		KEY_V:
			toggle_resolution()
			get_viewport().set_input_as_handled()
		KEY_L:
			set_leeway_enabled(not leeway_enabled)
			get_viewport().set_input_as_handled()
		KEY_F2:
			set_reference_overlay(not showing_reference)
			get_viewport().set_input_as_handled()
		KEY_H:
			set_hud_visible(not hud_visible)
			get_viewport().set_input_as_handled()


func set_resolution_preset(w: int, h: int) -> void:
	current_res = Vector2i(w, h)
	if world_viewport != null:
		world_viewport.size = current_res
	if scene_root != null:
		var scale_factor := float(w) / float(ART_BASE.x)
		scene_root.scale = Vector2(scale_factor, scale_factor)
	if _ground_mat != null:
		_ground_mat.set_shader_parameter("render_size", Vector2(current_res))
	_refresh_hud()


func toggle_resolution() -> void:
	if current_res.x == 960:
		set_resolution_preset(640, 360)
	else:
		set_resolution_preset(960, 540)


func set_leeway_enabled(enabled: bool) -> void:
	leeway_enabled = enabled
	_update_view(not enabled)


func set_reference_overlay(enabled: bool) -> void:
	showing_reference = enabled
	if reference_overlay != null:
		reference_overlay.visible = enabled
	_refresh_hud()


func set_hud_visible(enabled: bool) -> void:
	hud_visible = enabled
	if hud_layer != null:
		hud_layer.visible = enabled


func set_walk_position(lateral: float, distance: float, snap_camera := true, facing_dir := Vector2.DOWN) -> void:
	var clamped_dist := clampf(distance, ROAD_START, ROAD_END)
	var max_lat := maxf(road_at(clamped_dist).y - BOOT_EDGE_MARGIN, 8.0)
	hero_ground = Vector2(clampf(lateral, -max_lat, max_lat), clamped_dist)
	_facing_dir = facing_dir
	_anim_phase = 0.0
	_update_view(snap_camera)


func _update_view(snap_camera: bool) -> void:
	# Camera distance tracking: exact lock or 8-pixel vertical leeway band
	if snap_camera or not leeway_enabled or leeway_pixels <= 0.0:
		camera_distance = hero_ground.y
	else:
		var far_band := distance_at(BOOTS.y - leeway_pixels)
		var near_band := distance_at(BOOTS.y + leeway_pixels)
		camera_distance = clampf(camera_distance, hero_ground.y - far_band, hero_ground.y - near_band)

	camera_center = road_at(camera_distance).x

	# 1. Sunlit canyon-mouth horizon stays pinned vertically at Y = 0 (horizon line at Y = 88)
	# with gentle horizontal parallax following the S-curve road centerline.
	var horizon_shift := clampf(camera_center * 0.22, -88.0, 88.0)
	horizon_sprite.position = Vector2(-96.0 - roundf(horizon_shift), 0.0)

	# 2. Update perspective ground shader uniforms
	if _ground_mat != null:
		_ground_mat.set_shader_parameter("camera_distance", camera_distance)
		_ground_mat.set_shader_parameter("camera_center", camera_center)

	# 3. Project commander (grounded boots, soft contact shadow, depth-matched local scale)
	var hero_pos := project_point(hero_ground, camera_distance, camera_center)
	var hero_vs := scale_at(hero_ground.y, camera_distance)
	commander_node.position = hero_pos.round()
	commander_node.z_index = _depth_to_z(hero_ground.y, 4)
	_update_commander_visuals(hero_vs)

	# 4. Project all 2.5D wall wings, boulders, sagebushes, and curb accents
	for item in _props:
		var rel_dist := item.ground.y - camera_distance
		var min_rel := (26.0 - DEPTH) if item.is_wall else (58.0 - DEPTH)
		item.sprite.visible = rel_dist > min_rel
		if not item.sprite.visible:
			continue

		var vs := scale_at(item.ground.y, camera_distance) * item.art_scale
		# Prevent extreme giant close-range scaling right before a prop leaves behind the camera
		if vs > 5.5:
			item.sprite.visible = false
			continue

		var piv := item.pivot
		if item.flip_h:
			piv.x = float(item.sprite.texture.get_width()) - piv.x

		item.sprite.position = project_point(item.ground, camera_distance, camera_center).round()
		item.sprite.scale = Vector2(vs, vs)
		item.sprite.offset = (-piv * vs).round() / vs
		item.sprite.z_index = _depth_to_z(item.ground.y, item.z_bias)

		# Warm canyon atmospheric haze on distant layers (zero haze at spawn for foreground/mid)
		var haze := smoothstep(460.0, 1450.0, rel_dist)
		item.sprite.modulate = item.base_tint.lerp(Color("#d8ae82"), haze * 0.52)

	_refresh_hud()


func _depth_to_z(item_distance: float, bias: int) -> int:
	# Closer items (smaller item_distance) receive higher z_index so nearer walls,
	# boulders, bushes, and the Blue Commander always occlude farther layers cleanly.
	var rel := item_distance - camera_distance
	return clampi(1200 - int(roundf(rel * 1.4)) + bias, -3, 3500)


func _update_commander_visuals(view_scale: float) -> void:
	var row := 0
	var flip := false
	if _facing_dir.y < -0.5:
		row = 1  # Walking uphill (back view)
	elif _facing_dir.y > 0.5:
		row = 0  # Facing downhill / Image 9 spawn stance (front view)
	else:
		row = 2  # Side profile
		flip = _facing_dir.x < 0.0

	var col := 0
	if _anim_phase > 0.0:
		var seq := [1, 0, 3, 2]
		col = seq[int(floor(_anim_phase)) % 4]

	var total_scale := HERO_BASE_SCALE * view_scale
	commander_sprite.frame = row * 4 + col
	commander_sprite.flip_h = flip
	commander_sprite.scale = Vector2(total_scale, total_scale)
	var piv_x := HERO_PIVOT.x if not flip else (64.0 - HERO_PIVOT.x)
	commander_sprite.position = (-(Vector2(piv_x, HERO_PIVOT.y) * total_scale)).round()

	# Grounded soft contact shadow directly beneath her boots
	commander_shadow.scale = Vector2(1.45 * view_scale, 1.05 * view_scale)
	commander_shadow.position = Vector2(0.0, -2.0 * view_scale).round()


func _refresh_hud() -> void:
	if status_label == null:
		return
	var leeway_str := "8px leeway" if leeway_enabled else "Exact lock"
	var ref_tag := "  |  [F2 REF OVERLAY]" if showing_reference else ""
	var boots_y := project_point(hero_ground, camera_distance, camera_center).y
	status_label.text = (
		"IMAGE 9 · 2.5D PERSPECTIVE FOLLOW  |  DIST: %+d  |  CAM: %+d (%s)  |  BOOTS Y: %d  |  RES: %dx%d%s"
		% [
			int(roundf(hero_ground.y)),
			int(roundf(camera_distance)),
			leeway_str,
			int(roundf(boots_y)),
			current_res.x,
			current_res.y,
			ref_tag,
		]
	)
	if controls_label != null:
		controls_label.text = "WASD/Arrows: Walk  |  L: 8px Leeway  |  1/2/V: 960x540 <-> 640x360  |  F2: Image 9 Ref  |  H: HUD  |  Esc: Back"
