# Godot 4+ .gitignore
.godot/
*.translation

# Mono / C#
.vs/
*.csproj
*.sln

# OS metadata
Thumbs.db
.DS_Store

# Blender backups
*.blend1
*.blend2

# Render outputs / temp captures
render_captures/
tmp/

# Godot builds and binaries
builds/
build/
export/
bin/
*.exe
*.pck
*.apk
*.aab

# Python caches
__pycache__/
